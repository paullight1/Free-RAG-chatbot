# Rotate API keys before exposing the service. Maps tenant_id -> tenant secret.
TENANT_API_KEYS_JSON={"demo":"replace-with-a-random-32-character-secret"}
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=industry_rag_documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave LLM_MODEL empty to run retrieval-only and avoid paid APIs.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
MAX_UPLOAD_BYTES=10000000
MAX_CHUNKS_PER_DOCUMENT=500
